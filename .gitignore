# ============================================================
# Sensitive files — NEVER commit these
# ============================================================
.env
.env.*
*.pem
*_rsa
*_rsa.pub
*_ed25519
*_ed25519.pub
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.key
*.p12
*.pfx
*.cer
*.crt

# Claude Desktop config — app-owned, never commit it (no template ships either)
_configs/claude_desktop_config.json

# Downloaded installers — never commit binary blobs. scripts/karabiner-driver.sh
# fetches the driver pkg into mktemp, but a hand-run `curl -LO` lands here.
*.pkg
*.dmg
*.zip

# Private Kanata config
_configs/kanata-private.kbd

# ============================================================
# Vim
# ============================================================
.netrwhist
.netrwhist~
_vim/bundle/

# ============================================================
# Atom (deprecated)
# ============================================================
_atom/packages
_atom/storage
_atom/.node-gyp
_atom/config.cson
_atom/projects.cson

# ============================================================
# macOS
# ============================================================
.DS_Store
**/.DS_Store
