[color]
    diff = auto
    status = auto
    branch = auto
    ui = true
[color "branch"]
  current = green bold
  remote = red bold
[color "diff"]
  meta = yellow
  frag = cyan bold
  old = red bold
  new = green bold
[color "status"]
  added = green bold
  changed = red bold
  untracked = red bold

[push]
	default = simple
	# create the upstream ref on first push instead of erroring
	autoSetupRemote = true

# Shared preferences — NOT machine-specific, so they belong here rather than in
# a local override. init.defaultBranch lived only in one machine's
# ~/.gitconfig.local, so every other machine silently fell back to git's built-in
# "master" when running `git init`.
[init]
	defaultBranch = main
[core]
    autocrlf = input
    editor = /usr/bin/vim
    page = less -R
    pager = less -+$LESS -FRX
    excludesfile = ~/.gitignore
[format]
    pretty = format:%C(yellow)%h %C(green)%ad %C(red)%d%C(reset) %s %C(blue)[%an]%C(reset)
[alias]
    br = branch
    ci = commit
    co = checkout
    df = diff
    ds = diff --staged
    fe = fetch
    lg = log --date=short
    gr = log --graph --date=short
    gra = log --graph --date=short --all
    mg = merge
    pdf = diff @{1}..
    ps = push
    pu = pull
    sh = stash
    st = status -sb
    wd = diff --color-words
    wdiff = diff --color-words
    undo = reset --soft HEAD^
    amend = commit --amend -C HEAD
    check = !"git diff @{1}..HEAD --name-status"
    last = diff @{1}..

    # alias gi to git for typos (eg: 'gi tst' instead of 'git st')
    tst = status
[merge]
	tool = vimdiff
	conflictstyle = diff3
[status]
	displayCommentPrefix = true
[pull]
	rebase = false

# ============================================================
# Local overrides — these MUST stay at the very END of this file.
# Git takes the LAST value it sees, so an include placed earlier is overridden
# by any section below it. ~/.private/github used to sit mid-file, above
# [merge]/[status]/[pull], which silently ignored anything it set for those keys.
#
#   ~/.private/github    long-standing personal file, not in the repo
#   ~/.gitconfig.local   per-machine settings + identity, not in the repo
#
# Later wins, so ~/.gitconfig.local beats ~/.private/github on any overlap.
# Both are optional; git ignores a missing include path.
# ============================================================
[include]
    path = ~/.private/github
[include]
    path = ~/.gitconfig.local

# ============================================================
# Personal projects use the personal identity, work is the default.
# Conditional includes obey the same last-one-wins rule as the plain includes
# above, so this must stay after them — but note it is SCOPED: it only applies
# under ~/personal/projects/, so it cannot shadow a machine-local identity
# anywhere else. Identity itself lives in ~/.private/, never in this repo.
# ============================================================
[includeIf "gitdir:~/personal/projects/"]
    path = ~/.private/github-personal
